# Copy this file to .env and replace placeholders. Never commit the real .env.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5433/COMPLETERAGCHAINHISTORY

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-secret

# Local HTTP development; use production behind HTTPS when deployed.
APP_ENV=development

# Local PostgreSQL on this machine does not use SSL.
PGSSLMODE=disable

# Ollama server URL; use the reachable Ollama host when deploying.
OLLAMA_BASE_URL=http://localhost:11434

# Create an API key in your Groq account. Do not commit the real key.
GROQ_API_KEY=your-groq-api-key

# Optional LangSmith tracing; enable with --trace-langsmith when running evaluation.
# Traces include prompts, retrieved medical context, and model outputs.
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=medical-chatbot-rag-eval
